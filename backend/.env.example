# Django
DJANGO_SECRET_KEY=your-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=georgetown-signal-api.onrender.com,localhost

# Supabase PostgreSQL (Settings → Database → URI)
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Supabase API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret   # Settings → API → JWT Secret

# Redis (Render)
REDIS_URL=redis://red-xxxxxxxxxx:6379

# CORS
CORS_ALLOWED_ORIGINS=https://georgetownsignal.com,https://georgetown-signal.vercel.app

# Email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# CallAnchor
CALLANCHOR_API_KEY=your-callanchor-key

# Gemini (Google AI Studio — free tier available)
# Get key at: aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key

# Frontend URL (for questionnaire links in emails)
FRONTEND_URL=https://georgetownsignal.com
